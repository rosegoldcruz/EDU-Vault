  "practicalDefiBootcamp": {
    "weeks": [
      {
        "week": "1",
        "theme": "Welcome to Web3 & Why DeFi Matters",
        "topics": "Web1 → Web2 → Web3 evolution; blockchain and decentralization basics; DeFi fundamentals and safety",
        "outcome": "Explain the DeFi landscape and identify relevant opportunities and risks."
      },
      {
        "week": "2",
        "theme": "Your First Wallet & Moving Money",
        "topics": "Hot vs. cold wallets; security best practices; send and receive crypto on testnet",
        "outcome": "Create a secure practice wallet and complete test transactions."
      },
      {
        "week": "3",
        "theme": "Stablecoins and Digital Dollars",
        "topics": "USDT, USDC, DAI, and other stablecoin models; centralized vs. decentralized; remittance, settlement, and savings use cases",
        "outcome": "Explain stablecoin models and evaluate cross-border and treasury use cases."
      },
      {
        "week": "4",
        "theme": "Trading Without Banks — DEXs",
        "topics": "Uniswap and PancakeSwap basics; liquidity pools; CEX vs. DEX comparison",
        "outcome": "Execute a practice token swap and explain liquidity mechanics."
      },
      {
        "week": "5",
        "theme": "Lending, Borrowing & Yield",
        "topics": "Aave and Compound; collateral and liquidation; yield-farming fundamentals",
        "outcome": "Calculate example positions and explain yield, leverage, collateral, and liquidation risk."
      },
      {
        "week": "6",
        "theme": "DAOs and Digital Cooperatives",
        "topics": "DAO fundamentals and governance; token-based voting; organizational and community applications",
        "outcome": "Participate in a simulated governance proposal and vote."
      },
      {
        "week": "7",
        "theme": "NFTs & Tokenization of Assets",
        "topics": "NFTs beyond art: access, tickets, identity, property claims; fractional ownership concepts; digital ownership models",
        "outcome": "Mint a practice NFT and explain tokenization models and limitations."
      },
      {
        "week": "8",
        "theme": "Security & the Future of Web3",
        "topics": "Common threats; security tools and practices; regulation; career and participation pathways",
        "outcome": "Graduate able to navigate core Web3 activities with a documented safety framework."
      }
    ]
  },
