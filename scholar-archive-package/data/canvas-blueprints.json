    },
    {
      "title": "Blockchain Foundations",
      "learner": "Professionals and advisors",
      "outcome": "Explain blockchain mechanics, consensus, cryptography, wallets, dApps, and business use cases."
    },
    {
      "title": "DeFi Practitioner",
      "learner": "Beginner-to-intermediate users",
      "outcome": "Safely practice wallets, stablecoins, swaps, lending, governance, tokenization, and security."
    },
    {
      "title": "Web3 Developer",
      "learner": "Developers and technical learners",
      "outcome": "Build, test, secure, and ship Solidity contracts and Ethereum applications."
    },
    {
      "title": "Architecture & Enterprise",
      "learner": "Architects, operators, and business leaders",
      "outcome": "Evaluate platforms, governance, architecture, integration, risk, and adoption."
    },
    {
      "title": "Security, Risk & Compliance",
      "learner": "Operators, analysts, and regulated teams",
      "outcome": "Manage keys, cyber risk, smart-contract risk, data protection, and sanctions awareness."
    },
    {
      "title": "AI Prompt Engineer",
      "learner": "Creators, operators, marketers, and developers",
      "outcome": "Use conversational, image, music, and developer-oriented generative AI workflows."
    },
    {
      "title": "Web3 Growth & Community",
      "learner": "Founders, growth teams, and community operators",
      "outcome": "Position, fund, distribute, and sustain a Web3 project responsibly."
    }
  ],
