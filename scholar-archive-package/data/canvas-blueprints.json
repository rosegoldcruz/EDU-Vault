  "web3GrowthCommunity": [
    {
      "module": "1. Project essence",
      "lesson": "Define what the project is, the problem it addresses, its tagline, its keywords, its differentiated value, and the audience that should care."
    },
    {
      "module": "2. Target audience",
      "lesson": "Analyze who the strategy is for. Separate newcomers, experienced users, builders, investors, operators, and institutional audiences rather than marketing to everyone."
    },
    {
      "module": "3. Marketing budget",
      "lesson": "Establish available budget before selecting tactics. Distinguish paid acquisition, content, partnerships, events, creators, community operations, and experimentation."
    },
    {
      "module": "4. Channel possibilities",
      "lesson": "Evaluate influencer marketing, blockchain SEO, email, educational content, partnerships, community programs, airdrops where appropriate, and other distribution channels against the audience and budget."
    },
    {
      "module": "5. Community continuity",
      "lesson": "Support early users, maintain communication, collect feedback, and convert community trust into long-term participation and advocacy."
    }
  ],
