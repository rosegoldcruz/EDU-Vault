{
  "name": "iron-vault-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "pm2 start ecosystem.config.cjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @iron-vault/web payments:migrate",
    "deploy": "git pull && pnpm install --frozen-lockfile && pnpm build && pnpm db:migrate && pm2 reload ecosystem.config.cjs --update-env"
  },
  "devDependencies": {
    "turbo": "^2.0.14"
  }
}
