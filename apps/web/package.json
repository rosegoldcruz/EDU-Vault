{
  "name": "@iron-vault/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "rewards:payout:dry-run": "tsx scripts/rewards-payout-dry-run.ts",
    "rewards:worker:once": "tsx scripts/reward-payout-worker.ts once",
    "rewards:worker": "tsx scripts/reward-payout-worker.ts loop",
    "payments:migrate": "tsx scripts/payments-migrate.ts",
    "payments:seed": "tsx scripts/payments-seed.ts",
    "payments:sweep": "tsx scripts/payments-sweep-worker.ts",
    "curriculum:import:legacy": "tsx scripts/import-legacy-curriculum.ts",
    "curriculum:import:scholar": "tsx scripts/import-scholar-archive.ts",
    "curriculum:verify:scholar-routes": "tsx scripts/verify-scholar-routes.ts",
    "members:grandfather:dry-run": "tsx scripts/grandfather-existing-privy-users.ts --dry-run",
    "members:grandfather:apply": "tsx scripts/grandfather-existing-privy-users.ts --apply"
  },
  "dependencies": {
    "@iron-vault/database": "workspace:*",
    "@privy-io/react-auth": "^3.35.0",
    "@privy-io/server-auth": "^1.32.5",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.106.2",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.17.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "pg": "^8.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.61.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
